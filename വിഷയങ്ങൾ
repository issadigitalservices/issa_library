
<!doctype html>
<html lang="ml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#10231f">
  <meta name="description" content="ISSA Kuttyalm - WhatsApp ശബ്ദ സന്ദേശങ്ങൾ വിഷയങ്ങൾ അനുസരിച്ച് സൂക്ഷിക്കാനും കേൾക്കാനും ഉള്ള ലൈബ്രറി">
  <title>ISSA Kuttyalm - ശബ്ദ ലൈബ്രറി</title>
  <style>
    :root {
      --bg:#f5f7f6;--panel:#fff;--ink:#172522;--muted:#66736f;
      --line:#e2e9e5;--green:#176b53;--green-dark:#105440;
      --mint:#e7f4ee;--amber:#fff3d8;--shadow:0 10px 30px rgba(22,48,39,.06);
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .app{min-height:100vh}
    .topbar{background:#10231f;color:white;padding:18px max(20px,calc((100vw - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px}
    .brand{display:flex;align-items:center;gap:12px;font-weight:750;letter-spacing:-.02em;font-size:19px}
    .brand-mark{width:40px;height:40px;border-radius:13px;background:#d4f0e2;color:#105440;display:grid;place-items:center;font-size:21px}
    .top-note{color:#c8d8d1;font-size:12px;text-align:right}
    .container{max-width:1180px;padding:28px 20px 56px;margin:auto}
    .hero{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
    h1{font-size:clamp(27px,4vw,38px);line-height:1.1;margin:0 0 9px;letter-spacing:-.04em}
    .sub{margin:0;color:var(--muted);max-width:650px}
    .pill{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:var(--mint);color:var(--green-dark);font-size:12px;font-weight:700;white-space:nowrap}
    .dot{width:7px;height:7px;background:#176b53;border-radius:50%}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
    .stat,.panel,.recording{background:var(--panel);border:1px solid var(--line);border-radius:17px;box-shadow:var(--shadow)}
    .stat{padding:17px 19px}
    .stat-label{color:var(--muted);font-size:13px}
    .stat-number{font-size:27px;font-weight:750;letter-spacing:-.04em;margin-top:3px}
    .layout{display:grid;grid-template-columns:265px minmax(0,1fr);gap:20px;align-items:start}
    .panel{padding:19px}
    .panel h2{font-size:16px;margin:0 0 15px}
    .subjects{display:grid;gap:8px}
    .subject-button{width:100%;display:flex;align-items:center;gap:11px;text-align:left;padding:11px 12px;border:1px solid transparent;border-radius:12px;background:transparent;color:var(--ink)}
    .subject-button:hover{background:#f4f8f5}
    .subject-button.active{background:var(--mint);border-color:#cce6d8;color:var(--green-dark);font-weight:700}
    .subject-icon{width:34px;height:34px;border-radius:10px;background:#f0f4f1;display:grid;place-items:center;font-size:17px;flex-shrink:0}
    .subject-button.active .subject-icon{background:#d4ecdf}
    .subject-name{flex:1}
    .count{color:var(--muted);font-size:12px}
    .privacy-note{margin-top:18px;border-top:1px solid var(--line);padding-top:15px;color:var(--muted);font-size:12px}
    .main-panel{min-width:0}
    .toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px}
    .toolbar h2{margin:0;font-size:20px;letter-spacing:-.02em}
    .actions{display:flex;gap:9px;flex-wrap:wrap}
    .btn{border:1px solid var(--line);background:white;color:var(--ink);border-radius:11px;padding:10px 13px;font-weight:650}
    .btn.primary{background:var(--green);color:white;border-color:var(--green)}
    .btn.primary:hover{background:var(--green-dark)}
    .btn:disabled{opacity:.6;cursor:wait}
    .search-row{display:flex;gap:10px;margin-bottom:16px}
    .search{flex:1;min-width:0;position:relative}
    .search input{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;outline:none}
    .search input:focus,input:focus,select:focus,textarea:focus{border-color:#6fae91;box-shadow:0 0 0 3px rgba(23,107,83,.09)}
    .filter-select{border:1px solid var(--line);border-radius:12px;padding:0 12px;background:#fff;color:var(--ink)}
    .recordings{display:grid;gap:11px}
    .recording{padding:15px;display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:13px;align-items:center;box-shadow:none}
    .audio-icon{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:var(--mint);color:var(--green);font-size:20px}
    .record-title{font-weight:750;margin:0 0 3px;overflow-wrap:anywhere}
    .meta{color:var(--muted);font-size:12px;display:flex;flex-wrap:wrap;gap:7px}
    .meta span+span:before{content:"·";margin-right:7px;color:#a0aaa5}
    .record-actions{display:flex;gap:7px;align-items:center}
    .icon-btn{border:1px solid var(--line);background:white;border-radius:10px;width:38px;height:38px;display:grid;place-items:center;color:var(--ink)}
    .icon-btn:hover{background:#f4f8f5}
    audio{display:block;width:100%;height:34px;margin-top:10px}
    .empty{text-align:center;padding:38px 18px;border:1px dashed #cbd7d0;border-radius:15px;color:var(--muted)}
    .empty strong{display:block;color:var(--ink);font-size:16px;margin-bottom:5px}
    .backend-notice{margin-top:20px;border:1px solid #cce6d8;background:#f4fbf6;border-radius:14px;padding:14px 16px;color:#315d48;font-size:13px}
    .backend-notice strong{display:block;margin-bottom:3px}
    .modal-backdrop{position:fixed;inset:0;background:rgba(10,24,20,.48);display:none;align-items:center;justify-content:center;padding:18px;z-index:5}
    .modal-backdrop.open{display:flex}
    .modal{width:min(520px,100%);background:white;border-radius:19px;padding:23px;box-shadow:0 20px 70px rgba(0,0,0,.2);max-height:90vh;overflow:auto}
    .modal h2{margin:0 0 6px;font-size:22px}
    .modal p{color:var(--muted);margin:0 0 18px;font-size:13px}
    .field{display:grid;gap:6px;margin-bottom:13px}
    .field label{font-size:13px;font-weight:700}
    .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px 12px;background:white;color:var(--ink)}
    .file-drop{border:1px dashed #b9cec2;background:#f7fbf8;border-radius:13px;padding:18px;text-align:center}
    .file-drop input{width:100%;margin-top:9px}
    .modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}
    .toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#10231f;color:white;padding:12px 17px;border-radius:12px;box-shadow:var(--shadow);display:none;z-index:10;max-width:calc(100vw - 30px)}
    .toast.show{display:block}
    .footer{color:var(--muted);text-align:center;font-size:12px;padding-top:25px}
    #issa-login-panel{max-width:420px;margin:24px auto;padding:24px;border:1px solid #ddd;border-radius:14px;font-family:Arial,sans-serif;background:#fff;color:#222}
    #issa-login-panel input,#issa-login-panel button{box-sizing:border-box;width:100%;padding:12px;margin-top:10px;border-radius:8px;font-size:15px}
    #issa-login-panel input{border:1px solid #ccc}
    #issa-login-panel button{border:0;background:#176b45;color:white;cursor:pointer}
    #issa-login-status{font-size:14px;overflow-wrap:anywhere}
    @media(max-width:800px){
      .layout{grid-template-columns:1fr}
      .subjects{grid-template-columns:repeat(2,minmax(0,1fr))}
      .privacy-note{margin-top:12px}
      .hero{align-items:flex-start;flex-direction:column}
      .top-note{display:none}
    }
    @media(max-width:520px){
      .container{padding:22px 13px 40px}
      .topbar{padding:13px}
      .stats{gap:8px}
      .stat{padding:12px}
      .stat-number{font-size:23px}
      .layout{gap:14px}
      .panel{padding:14px}
      .toolbar{align-items:flex-start;flex-direction:column}
      .search-row{flex-direction:column}
      .filter-select{min-height:42px}
      .recording{grid-template-columns:38px minmax(0,1fr);padding:12px;gap:10px}
      .audio-icon{width:38px;height:38px}
      .record-actions{grid-column:2;justify-content:flex-end}
      .record-title{font-size:14px}
      .subjects{gap:5px}
      .subject-button{padding:8px;gap:7px}
      .subject-icon{width:30px;height:30px}
    }
  </style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand"><div class="brand-mark">♫</div><span>ISSA Kuttyalm</span></div>
    <div class="top-note">പ്രധാനപ്പെട്ട സംഭാഷണങ്ങളുടെ ശേഖരം<br>വിഷയങ്ങൾ അനുസരിച്ച് ക്രമീകരിച്ച ശബ്ദ സന്ദേശങ്ങൾ</div>
  </header>

  <main class="container">
    <section class="hero">
      <div>
        <h1>ISSA ഗ്രൂപ്പിലെ ആശയങ്ങൾ ഇനി എളുപ്പത്തിൽ കണ്ടെത്താം.</h1>
        <p class="sub">WhatsApp ശബ്ദ സന്ദേശങ്ങൾ വിഷയം, തീയതി എന്നിവ അനുസരിച്ച് ക്രമീകരിച്ച് സൂക്ഷിക്കാം. ആവശ്യമുള്ളപ്പോൾ വീണ്ടും കേൾക്കാം.</p>
      </div>
      <div class="pill"><span class="dot"></span> ക്ലൗഡ് ലൈബ്രറി — അംഗീകൃത അംഗങ്ങൾക്ക്</div>
    </section>

    <section class="stats" aria-label="Library statistics">
      <div class="stat"><div class="stat-label">വിഷയങ്ങൾ</div><div class="stat-number" id="statവിഷയങ്ങൾ">4</div></div>
      <div class="stat"><div class="stat-label">ശബ്ദ സന്ദേശങ്ങൾ</div><div class="stat-number" id="statRecordings">0</div></div>
      <div class="stat"><div class="stat-label">തിരഞ്ഞെടുത്ത വിഷയം</div><div class="stat-number" id="statCurrent" style="font-size:19px">കരിയർ വികസനം</div></div>
    </section>

    <div class="layout">
      <aside class="panel">
        <h2>വിഷയങ്ങൾ തിരഞ്ഞെടുക്കുക</h2>
        <nav class="subjects" id="subjects" aria-label="വിഷയങ്ങൾ"></nav>
        <div class="privacy-note">🔒 ലോഗിൻ ചെയ്ത അംഗങ്ങൾക്ക് മാത്രം. അംഗീകൃത ഇമെയിൽ വിലാസങ്ങൾ Cloudflare Worker-ൽ അനുവദിച്ചിരിക്കണം.</div>
      </aside>

      <section class="panel main-panel">
        <div class="toolbar">
          <h2 id="sectionTitle">കരിയർ വികസനം</h2>
          <div class="actions">
            <button class="btn" id="newവിഷയംBtn" type="button">＋ വിഷയം ചേർക്കുക</button>
            <button class="btn primary" id="uploadBtn" type="button">＋ ശബ്ദ സന്ദേശങ്ങൾ ചേർക്കുക</button>
          </div>
        </div>
        <div class="search-row">
          <div class="search"><input id="searchInput" type="search" placeholder="പേരോ വിവരണങ്ങളോ തിരയുക…" aria-label="Search voice notes"></div>
          <select class="filter-select" id="sortSelect" aria-label="Sort recordings">
            <option value="newest">പുതിയത് ആദ്യം</option>
            <option value="oldest">പഴയത് ആദ്യം</option>
            <option value="title">പേര് അനുസരിച്ച്</option>
          </select>
        </div>
        <div id="recordings" class="recordings"></div>
        <div class="backend-notice">
          <strong>സ്വകാര്യ ക്ലൗഡ് ലൈബ്രറി</strong>
          ശബ്ദ സന്ദേശങ്ങൾ Cloudflare R2-ൽ സൂക്ഷിക്കുന്നു. ഓഡിയോ കേൾക്കാനും ചേർക്കാനും അംഗീകൃത ലോഗിൻ ആവശ്യമാണ്. പങ്കിടാൻ അനുമതിയുള്ള റെക്കോർഡിങ്ങുകൾ മാത്രം അപ്‌ലോഡ് ചെയ്യുക.
        </div>
      </section>
    </div>
    <div class="footer">ISSA Kuttyalm · പങ്കിടാൻ അനുമതിയുള്ള ശബ്ദ സന്ദേശങ്ങൾ മാത്രം സൂക്ഷിക്കുക.</div>
  </main>
</div>

<div class="modal-backdrop" id="uploadModal" role="dialog" aria-modal="true" aria-labelledby="uploadHeading">
  <form class="modal" id="uploadForm">
    <h2 id="uploadHeading">ശബ്ദ സന്ദേശങ്ങൾ ചേർക്കുക</h2>
    <p>ഓഡിയോ ഫയലുകൾ തിരഞ്ഞെടുക്കുക. ഓരോ ഫയലും സ്വകാര്യ ക്ലൗഡ് സ്റ്റോറേജിലേക്ക് അപ്‌ലോഡ് ചെയ്യും. ഒരു ഫയലിന് പരമാവധി 100 MB.</p>
    <div class="field"><label for="subjectSelect">വിഷയം</label><select id="subjectSelect" required></select></div>
    <div class="field"><label for="discussionDate">സംഭാഷണ തീയതി</label><input type="date" id="discussionDate" required></div>
    <div class="field"><label for="description">സംഭാഷണ വിഷയം (ഐച്ഛികം)</label><input id="description" maxlength="120" placeholder="ഉദാ: കരിയർ പ്ലാനിംഗും അഭിമുഖ നൈപുണ്യങ്ങളും"></div>
    <div class="field"><label for="speaker">സംസാരിക്കുന്നയാളുടെ പേര് (ഐച്ഛികം)</label><input id="speaker" maxlength="80" placeholder="അറിയാമെങ്കിൽ പേര് നൽകുക"></div>
    <div class="field file-drop"><strong>ഓഡിയോ ഫയലുകൾ തിരഞ്ഞെടുക്കുക</strong><div style="color:#66736f;font-size:12px">.ogg, .opus, .mp3, .m4a, .wav പോലുള്ള ഫയലുകൾ തിരഞ്ഞെടുക്കാം.</div><input id="audioFiles" type="file" accept="audio/*,.ogg,.opus,.m4a" multiple required></div>
    <div class="modal-actions"><button class="btn" type="button" id="cancelUpload">റദ്ദാക്കുക</button><button class="btn primary" type="submit">ക്ലൗഡിലേക്ക് അപ്‌ലോഡ് ചെയ്യുക</button></div>
  </form>
</div>

<div class="modal-backdrop" id="subjectModal" role="dialog" aria-modal="true" aria-labelledby="subjectHeading">
  <form class="modal" id="subjectForm">
    <h2 id="subjectHeading">പുതിയ വിഷയം ചേർക്കുക</h2>
    <p>ബന്ധപ്പെട്ട സംഭാഷണങ്ങൾ ഒരുമിച്ച് സൂക്ഷിക്കാൻ ഒരു വിഷയം ചേർക്കുക.</p>
    <div class="field"><label for="subjectName">വിഷയം</label><input id="subjectName" maxlength="60" placeholder="ഉദാ: ആശയവിനിമയ നൈപുണ്യങ്ങൾ" required></div>
    <div class="modal-actions"><button class="btn" type="button" id="cancelവിഷയം">റദ്ദാക്കുക</button><button class="btn primary" type="submit">വിഷയം ചേർക്കുക</button></div>
  </form>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  const initialവിഷയങ്ങൾ = [
    { id:"career",name:"കരിയർ വികസനം",icon:"💼" },
    { id:"education",name:"വിദ്യാഭ്യാസം",icon:"📚" },
    { id:"growth",name:"വ്യക്തിത്വ വികസനം",icon:"🌱" },
    { id:"other",name:"മറ്റ് വിഷയങ്ങൾ",icon:"🗂️" }
  ];
  let subjects = [...initialവിഷയങ്ങൾ];
  let recordings = [];
  let selectedവിഷയം = "career";
  let nextId = 1;
  const objectUrls = [];

  const $ = id => document.getElementById(id);
  const subjectName = id => subjects.find(s => s.id === id)?.name || "മറ്റ് വിഷയങ്ങൾ";
  const today = new Date();
  const localDate = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,"0")}-${String(today.getDate()).padStart(2,"0")}`;

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, ch => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[ch]));
  }

  function showToast(message) {
    const toast = $("toast");
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(() => toast.classList.remove("show"), 4000);
  }

  function renderવિષയങ്ങൾ() {
    $("subjects").innerHTML = subjects.map(s => {
      const count = recordings.filter(r => r.subjectId === s.id).length;
      return `<button type="button" class="subject-button ${selectedവിഷയം === s.id ? "active" : ""}" data-subject="${escapeHtml(s.id)}">
        <span class="subject-icon">${s.icon}</span><span class="subject-name">${escapeHtml(s.name)}</span><span class="count">${count}</span></button>`;
    }).join("");
    $("subjectSelect").innerHTML = subjects.map(s => `<option value="${escapeHtml(s.id)}">${escapeHtml(s.name)}</option>`).join("");
    $("statവിഷയങ്ങൾ").textContent = subjects.length;
  }

  function renderRecordings() {
    const query = $("searchInput").value.trim().toLowerCase();
    const sort = $("sortSelect").value;
    const list = recordings.filter(r => r.subjectId === selectedവിഷയം &&
      `${r.title} ${r.description || ""} ${r.speaker || ""} ${r.date || ""} ${r.fileName || ""}`.toLowerCase().includes(query));

    list.sort((a,b) => sort === "oldest" ? a.date.localeCompare(b.date) :
      sort === "title" ? a.title.localeCompare(b.title) : b.date.localeCompare(a.date));

    $("sectionTitle").textContent = subjectName(selectedവിഷയം);
    $("statCurrent").textContent = subjectName(selectedവിഷയം);
    $("statRecordings").textContent = recordings.length;

    if (!list.length) {
      $("recordings").innerHTML = `<div class="empty"><strong>${query ? "പൊരുത്തപ്പെടുന്ന ശബ്ദ സന്ദേശങ്ങളില്ല" : "ഇതുവരെ ശബ്ദ സന്ദേശങ്ങൾ ചേർത്തിട്ടില്ല"}</strong>${query ? "മറ്റൊരു വാക്ക് ഉപയോഗിച്ച് തിരയുക അല്ലെങ്കിൽ തിരച്ചിൽ മായ്ക്കുക." : "“ശബ്ദ സന്ദേശങ്ങൾ ചേർക്കുക” തിരഞ്ഞെടുക്കുക."}</div>`;
      return;
    }

    $("recordings").innerHTML = list.map(r => `<article class="recording">
      <div class="audio-icon">♫</div>
      <div class="record-content">
        <div class="record-title">${escapeHtml(r.title)}</div>
        <div class="meta"><span>${escapeHtml(r.date || "തീയതി നൽകിയിട്ടില്ല")}</span><span>${escapeHtml(r.speaker || "പേര് നൽകിയിട്ടില്ല")}</span><span>${escapeHtml(r.fileName || "audio")}</span></div>
        ${r.description ? `<div style="font-size:13px;color:#66736f;margin-top:5px">${escapeHtml(r.description)}</div>` : ""}
        ${r.cloud ? `<button type="button" class="btn" data-play-key="${escapeHtml(r.key)}" style="margin-top:8px">▶ ഓഡിയോ ലോഡ് ചെയ്യുക / കേൾക്കുക</button><audio controls preload="none" data-audio-key="${escapeHtml(r.key)}" style="display:none"></audio>` : ""}
      </div>
      <div class="record-actions"><button type="button" class="icon-btn" data-delete-key="${escapeHtml(r.key)}" aria-label="Delete ${escapeHtml(r.title)}" title="ക്ലൗഡിൽ നിന്ന് ഇല്ലാതാക്കുക">×</button></div>
    </article>`).join("");
  }

  async function loadCloudRecordings() {
    if (typeof window.issaApiRequest !== "function") return;
    if (!window.issaCurrentUser) {
      recordings = [];
      renderവിഷയങ്ങൾ();
      renderRecordings();
      return;
    }
    try {
      const response = await window.issaApiRequest("/api/recordings");
      const data = await response.json();
      const cloudItems = (data.recordings || []).map(item => {
        let subjectId = item.subjectId || "other";
        if (!subjects.some(s => s.id === subjectId)) {
          const matching = subjects.find(s => s.name === item.subject);
          if (matching) subjectId = matching.id;
          else {
            subjectId = "cloud-" + (item.subject || "other");
            if (!subjects.some(s => s.id === subjectId)) {
              subjects.push({ id:subjectId,name:item.subject || "മറ്റ് വിഷയങ്ങൾ",icon:"📁" });
            }
          }
        }
        const cleanName = (item.filename || "audio").replace(/\.[^.]+$/, "").replace(/[_-]+/g," ").trim();
        return {
          id:item.key,key:item.key,cloud:true,subjectId,date:item.date || "",
          description:item.description || "",speaker:item.speaker || "",
          title:cleanName || item.filename || "ശബ്ദ സന്ദേശം",
          fileName:item.filename || "audio"
        };
      });
      recordings = cloudItems;
      renderവിഷയങ്ങൾ();
      renderRecordings();
    } catch (error) {
      console.error("Cloud listing failed:", error);
      showToast(error.message || "ക്ലൗഡ് ലൈബ്രറി ലോഡ് ചെയ്യാൻ കഴിഞ്ഞില്ല.");
    }
  }

  function openModal(id) { $(id).classList.add("open"); }
  function closeModal(id) { $(id).classList.remove("open"); }

  $("subjects").addEventListener("click", e => {
    const button = e.target.closest("[data-subject]");
    if (!button) return;
    selectedവിഷയം = button.dataset.subject;
    renderവിഷയങ്ങൾ();
    renderRecordings();
  });

  $("searchInput").addEventListener("input", renderRecordings);
  $("sortSelect").addEventListener("change", renderRecordings);

  $("uploadBtn").addEventListener("click", () => {
    if (!window.issaCurrentUser) {
      showToast("ആദ്യം ലോഗിൻ ചെയ്യുക.");
      $("issa-login-panel").scrollIntoView({ behavior:"smooth",block:"center" });
      return;
    }
    $("subjectSelect").value = selectedവിഷയം;
    $("discussionDate").value = localDate;
    openModal("uploadModal");
  });

  $("cancelUpload").addEventListener("click", () => closeModal("uploadModal"));
  $("newവിഷയംBtn").addEventListener("click", () => {
    if (!window.issaCurrentUser) {
      showToast("ആദ്യം ലോഗിൻ ചെയ്യുക.");
      return;
    }
    openModal("subjectModal");
  });
  $("cancelവിഷയം").addEventListener("click", () => closeModal("subjectModal"));

  $("subjectForm").addEventListener("submit", e => {
    e.preventDefault();
    const name = $("subjectName").value.trim();
    if (!name) return;
    if (subjects.some(s => s.name.toLowerCase() === name.toLowerCase())) {
      showToast("ഈ വിഷയം ഇതിനകം നിലവിലുണ്ട്.");
      return;
    }
    const id = "subject-" + Date.now();
    subjects.push({ id,name,icon:"📁" });
    selectedവിഷയം = id;
    $("subjectName").value = "";
    closeModal("subjectModal");
    renderവിഷയങ്ങൾ();
    renderRecordings();
    showToast("വിഷയം ചേർത്തു. ഈ പുതിയ വിഷയം ആദ്യ റെക്കോർഡിങ് അപ്‌ലോഡ് ചെയ്യുമ്പോൾ സൂക്ഷിക്കും.");
  });

  $("uploadForm").addEventListener("submit", async e => {
    e.preventDefault();
    const files = Array.from($("audioFiles").files || []);
    if (!files.length) {
      showToast("കുറഞ്ഞത് ഒരു ഓഡിയോ ഫയലെങ്കിലും തിരഞ്ഞെടുക്കുക.");
      return;
    }
    if (typeof window.issaApiRequest !== "function" || !window.issaCurrentUser) {
      showToast("ഓഡിയോ അപ്‌ലോഡ് ചെയ്യാൻ ആദ്യം ലോഗിൻ ചെയ്യുക.");
      return;
    }
    if (files.some(file => file.size > 100 * 1024 * 1024)) {
      showToast("ഓരോ ഓഡിയോ ഫയലും 100 MB-ൽ താഴെയായിരിക്കണം.");
      return;
    }

    const subjectId = $("subjectSelect").value;
    const subject = subjectName(subjectId);
    const date = $("discussionDate").value || localDate;
    const description = $("description").value.trim();
    const speaker = $("speaker").value.trim();
    const submitButton = $("uploadForm").querySelector('button[type="submit"]');
    submitButton.disabled = true;
    let uploaded = 0;

    try {
      for (const file of files) {
        const formData = new FormData();
        formData.append("file",file,file.name);
        formData.append("subject",subject);
        formData.append("subjectId",subjectId);
        formData.append("date",date);
        formData.append("description",description);
        formData.append("speaker",speaker);

        const response = await window.issaApiRequest("/api/recordings",{
          method:"POST",
          body:formData
        });
        await response.json();
        uploaded++;
      }

      selectedવિષയം = subjectId;
      $("uploadForm").reset();
      closeModal("uploadModal");
      await loadCloudRecordings();
      showToast(`${uploaded} ഫയൽ(കൾ) ക്ലൗഡിലേക്ക് അപ്‌ലോഡ് ചെയ്തു.`);
    } catch (error) {
      showToast(`${uploaded} ഫയൽ(കൾ) അപ്‌ലോഡ് ചെയ്തു. ${error.message || "അപ്‌ലോഡ് പരാജയപ്പെട്ടു."}`);
      await loadCloudRecordings();
    } finally {
      submitButton.disabled = false;
    }
  });

  $("recordings").addEventListener("click", async e => {
    const deleteButton = e.target.closest("[data-delete-key]");
    if (deleteButton) {
      const key = deleteButton.dataset.deleteKey;
      if (!confirm("ഈ ശബ്ദ സന്ദേശം ക്ലൗഡിൽ നിന്ന് സ്ഥിരമായി ഇല്ലാതാക്കണോ?")) return;
      deleteButton.disabled = true;
      try {
        await window.issaApiRequest(`/api/recordings?key=${encodeURIComponent(key)}`,{method:"DELETE"});
        recordings = recordings.filter(r => r.key !== key);
        renderവിഷയങ്ങൾ();
        renderRecordings();
        showToast("ക്ലൗഡ് റെക്കോർഡിങ് ഇല്ലാതാക്കി.");
      } catch (error) {
        deleteButton.disabled = false;
        showToast(error.message || "ഇല്ലാതാക്കാൻ കഴിഞ്ഞില്ല.");
      }
      return;
    }

    const playButton = e.target.closest("[data-play-key]");
    if (!playButton) return;
    const key = playButton.dataset.playKey;
    const card = playButton.closest(".recording");
    const audio = card?.querySelector("audio[data-audio-key]");
    if (!audio) return;

    if (audio.dataset.loaded === "yes") {
      audio.style.display = "block";
      await audio.play().catch(() => {});
      return;
    }

    playButton.disabled = true;
    playButton.textContent = "ഓഡിയോ ലോഡ് ചെയ്യുന്നു...";
    try {
      const response = await window.issaApiRequest(`/api/audio?key=${encodeURIComponent(key)}`);
      const blob = await response.blob();
      const blobUrl = URL.createObjectURL(blob);
      objectUrls.push(blobUrl);
      audio.src = blobUrl;
      audio.dataset.loaded = "yes";
      audio.style.display = "block";
      playButton.textContent = "ഓഡിയോ തയ്യാറായി";
      await audio.play().catch(() => {});
    } catch (error) {
      playButton.disabled = false;
      playButton.textContent = "▶ വീണ്ടും ശ്രമിക്കുക";
      showToast(error.message || "ഓഡിയോ പ്ലേ ചെയ്യാൻ കഴിഞ്ഞില്ല.");
    }
  });

  document.querySelectorAll(".modal-backdrop").forEach(backdrop => {
    backdrop.addEventListener("click", e => {
      if (e.target === backdrop) backdrop.classList.remove("open");
    });
  });

  window.addEventListener("beforeunload", () => objectUrls.forEach(url => URL.revokeObjectURL(url)));
  window.addEventListener("issa-auth-ready", () => loadCloudRecordings());
  renderവിഷയങ്ങൾ();
  renderRecordings();
})();
</script>

<section id="issa-login-panel">
  <h2>ISSA Kuttyalm</h2>
  <p>വോയ്സ് ലൈബ്രറിയിലേക്ക് ലോഗിൻ ചെയ്യുക</p>
  <form id="issa-login-form">
    <input id="issa-email" type="email" placeholder="Email address" autocomplete="username" required>
    <input id="issa-password" type="password" placeholder="Password" autocomplete="current-password" required>
    <button type="submit">Login / ലോഗിൻ</button>
  </form>
  <button id="issa-logout" type="button" hidden>Logout / ലോഗൗട്ട്</button>
  <p id="issa-login-status" role="status" aria-live="polite">ലോഗിൻ ചെയ്യാൻ നിങ്ങളുടെ അക്കൗണ്ട് ഉപയോഗിക്കുക.</p>
</section>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";
  import {
    getAuth,
    signInWithEmailAndPassword,
    signOut,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyDZYAe5F1SoEYhX8ScMsUbw-YlxlJiCuA8",
    authDomain: "issa-kuttyalm-library.firebaseapp.com",
    projectId: "issa-kuttyalm-library",
    storageBucket: "issa-kuttyalm-library.firebasestorage.app",
    messagingSenderId: "1047702594894",
    appId: "1:1047702594894:web:147df9aa7461331a296a1f"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const form = document.getElementById("issa-login-form");
  const emailInput = document.getElementById("issa-email");
  const passwordInput = document.getElementById("issa-password");
  const status = document.getElementById("issa-login-status");
  const logoutButton = document.getElementById("issa-logout");

  form.addEventListener("submit", async event => {
    event.preventDefault();
    status.textContent = "ലോഗിൻ പരിശോധിക്കുന്നു...";
    try {
      await signInWithEmailAndPassword(auth,emailInput.value.trim(),passwordInput.value);
      passwordInput.value = "";
    } catch (error) {
      console.error("Firebase login failed:",error.code);
      status.textContent = "ലോഗിൻ പരാജയപ്പെട്ടു. Email, password എന്നിവ പരിശോധിക്കുക.";
    }
  });

  logoutButton.addEventListener("click",async () => {
    try {
      await signOut(auth);
    } catch {
      status.textContent = "ലോഗൗട്ട് ചെയ്യാൻ കഴിഞ്ഞില്ല.";
    }
  });

  const ISSA_API_BASE = "https://soft-brook-2c8eissa-kuttyalm-voice-api.issakuttyalm.workers.dev";
  window.issaCurrentUser = null;

  window.issaApiRequest = async function(path,options = {}) {
    const user = auth.currentUser;
    if (!user) throw new Error("ആദ്യം ലോഗിൻ ചെയ്യുക.");
    const token = await user.getIdToken();
    const headers = new Headers(options.headers || {});
    headers.set("Authorization",`Bearer ${token}`);

    const response = await fetch(`${ISSA_API_BASE}${path}`,{
      ...options,
      headers
    });

    if (!response.ok) {
      const result = await response.json().catch(() => ({}));
      throw new Error(result.error || `Request failed: ${response.status}`);
    }
    return response;
  };

  onAuthStateChanged(auth,user => {
    window.issaCurrentUser = user || null;
    form.hidden = Boolean(user);
    logoutButton.hidden = !user;
    status.textContent = user
      ? `ലോഗിൻ ചെയ്തു: ${user.email}`
      : "ലോഗിൻ ചെയ്യാൻ നിങ്ങളുടെ അക്കൗണ്ട് ഉപയോഗിക്കുക.";
    window.dispatchEvent(new CustomEvent("issa-auth-ready",{
      detail:{signedIn:Boolean(user)}
    }));
  });
</script>
</body>
